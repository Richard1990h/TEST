{
  "mcpServers": {
    "cloud-bridge-test": {
      "type": "http",
      "url": "${CLOUD_BRIDGE_URL:-https://bridge-test.example.com/mcp}",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}",
        "X-Bridge-Key": "${BRIDGE_TEST_KEY}"
      }
    }
  }
}
